class Tile:
    def__init__(self, tile_id, correct_position):
        self._tile_id=tile_id
        self._correct_position = correct_position
        
    def transform(self):
        print(f"{self._tile_id} transformed.")
        
    def get_correct_position(self):
        return self._correct_position
    
    def set_correct_position(self, new_position):
        self._correct_position=new_position
        
    def display (self):
        print (f"Tile ID: {self._tile_id}, correct_position:{self._correct_position}")
        
